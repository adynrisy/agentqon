# AgentQon — production environment template (prepared 2026-10-10)
# AGENTQON_* is the preferred prefix; the legacy OMNIMIND_* spellings
# are still read as a fallback, so existing .env files keep working.
# Copy to .env.production and fill in. NEVER commit the filled file.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Postgres password used by docker-compose.yml (db + api + worker)
POSTGRES_PASSWORD=CHANGE_ME

# --- Auth: MUST be accounts for any public deployment (dev header mode is local-only) ---
AGENTQON_AUTH_MODE=accounts
AGENTQON_ADMIN_KEY=CHANGE_ME
AGENTQON_SESSION_TTL_HOURS=24

# --- BYOK vault: generate a Fernet key, keep it backed up — losing it = stored keys unrecoverable ---
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTQON_VAULT_KEY=CHANGE_ME

# --- Model connection (v20): generation requires a real model — env endpoint below,
#     tenant BYOK, an OmniRoute sidecar, or auto-detected local Ollama. No model = runs
#     are refused with `model_not_connected`; there is no demo/canned mode. ---
# AGENTQON_LLM_BASE_URL=
# AGENTQON_LLM_API_KEY=
# AGENTQON_LLM_MODEL=

# --- Live web research (Phase 5) ---
AGENTQON_RESEARCH_MODE=live

# --- Optional OIDC (leave unset unless connecting an identity provider) ---
# AGENTQON_OIDC_ISSUER=
# AGENTQON_OIDC_CLIENT_ID=
