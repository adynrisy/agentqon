# AgentQon — example environment (copy to .env or export in your shell)
# AGENTQON_* is the preferred prefix; the legacy OMNIMIND_* spellings
# are still read as a fallback, so existing .env files keep working.
# NEVER commit a real .env with secrets.

# --- Storage: omit DATABASE_URL for SQLite dev mode ---
AGENTQON_DATABASE_URL=postgresql://agentqon:change-me@127.0.0.1:5432/agentqon
AGENTQON_DATA=./data

# --- Model connection (v20): generation requires a real model ---
# Any OpenAI-compatible endpoint. Default is a local Ollama; if Ollama
# (or an OmniRoute sidecar on :20128) is already running and nothing is
# set here, it is auto-detected. With NO reachable model, runs are
# refused with `model_not_connected` — there is no canned fallback.
# Cloud examples: https://api.openai.com/v1 · https://openrouter.ai/api/v1 · https://api.groq.com/openai/v1
AGENTQON_LLM_BASE_URL=http://127.0.0.1:11434/v1
AGENTQON_LLM_API_KEY=ollama
AGENTQON_LLM_MODEL=qwen2.5:1.5b
# USD per 1M tokens (0 for local models). Used for the mission cost ledger.
AGENTQON_LLM_PRICE_IN=0
AGENTQON_LLM_PRICE_OUT=0

# --- Execution: inline (API runs jobs itself) or external (separate worker) ---
AGENTQON_WORKER_MODE=external

# --- V3: BYOK vault, routing, admin ---
# Master key for the credential vault (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Versioned rotation: AGENTQON_VAULT_KEY_V2, _V3, ... older keys keep decrypting.
AGENTQON_VAULT_KEY=
# Conservative per-call reservation (USD) when a model's price is unknown.
AGENTQON_RESERVE_UNKNOWN_CALL_USD=0.50
# Admin key for /v1/admin/* (empty = admin API disabled).
AGENTQON_ADMIN_KEY=
# Dev only: allow gateway connections to loopback/private URLs (e.g. a
# local OmniRoute sidecar). Leave unset in production.
AGENTQON_ALLOW_LOCAL_GATEWAY=

# --- Phase 4: accounts, OIDC, rate limits, vault key file ---
# dev = header identity (local only). accounts = real users + roles.
AGENTQON_AUTH_MODE=dev
# OIDC bearer tokens (optional): issuer URL + expected audience.
AGENTQON_OIDC_ISSUER=
AGENTQON_OIDC_CLIENT_ID=
AGENTQON_SESSION_TTL_HOURS=168
AGENTQON_RATE_LOGIN_PER_MIN=5
AGENTQON_RATE_RUN_PER_MIN=30
AGENTQON_RATE_VALIDATE_PER_MIN=10
# Vault keys from a file (one Fernet key per line, last = active) — the
# seam a KMS/secrets manager mounts into. Overrides AGENTQON_VAULT_KEY.
AGENTQON_VAULT_KEY_FILE=

# --- Phase 5: live web research ---
# live = agents research the real web via the Tool Gateway (default);
# seed = demonstration corpus only.
AGENTQON_RESEARCH_MODE=live
AGENTQON_RESEARCH_MAX_FETCHES=5

# --- v16: Telegram front door (all optional; unset token = disabled) ---
# Bot token from @BotFather. NEVER commit a real token.
AGENTQON_TELEGRAM_BOT_TOKEN=
# Your own random secret, registered with setWebhook as secret_token.
AGENTQON_TELEGRAM_WEBHOOK_SECRET=
# Bot username without @ (only builds the t.me deep link in the UI).
AGENTQON_TELEGRAM_BOT_USERNAME=
# Bot API base (default https://api.telegram.org; stubs override this).
AGENTQON_TELEGRAM_API_BASE=

# --- v17: WhatsApp front door / Meta Cloud API (all optional) ---
# Channel is enabled only when BOTH the token and the phone number id
# are set. NEVER commit a real token.
AGENTQON_WHATSAPP_TOKEN=
# The Cloud API phone number ID (app settings — not the number itself).
AGENTQON_WHATSAPP_PHONE_NUMBER_ID=
# Your own webhook verify token (the GET subscription handshake).
AGENTQON_WHATSAPP_VERIFY_TOKEN=
# Meta app secret: when set, POST webhooks MUST carry a valid
# X-Hub-Signature-256. When unset the webhook is UNAUTHENTICATED —
# local development only, never production (see README).
AGENTQON_WHATSAPP_APP_SECRET=
# Graph API base + version (defaults https://graph.facebook.com / v21.0;
# stubs override the base in tests).
AGENTQON_WHATSAPP_API_BASE=
AGENTQON_WHATSAPP_API_VERSION=
# Business number, digits only with country code — builds the wa.me
# tap-to-link URL in the UI/API.
AGENTQON_WHATSAPP_BUSINESS_NUMBER=
# Approved utility template for out-of-window result alerts (body {{1}}
# = mission title) + its language. Empty name = out-of-window results
# are held and delivered on the user's next message.
AGENTQON_WHATSAPP_TEMPLATE_NAME=
AGENTQON_WHATSAPP_TEMPLATE_LANG=en

# --- v18: WhatsApp self-serve onboarding / Embedded Signup (optional) ---
# Public Meta App ID (developers.facebook.com → your app → Settings →
# Basic). Public value: the web UI initialises the Facebook SDK with it.
AGENTQON_META_APP_ID=
# Facebook Login for Business CONFIGURATION id for the WhatsApp
# embedded-signup flow (app console → Facebook Login for Business →
# Configurations). Public value. Both set (plus the app secret above)
# = the "Connect WhatsApp with Facebook" button appears in the panel.
AGENTQON_WHATSAPP_CONFIG_ID=
